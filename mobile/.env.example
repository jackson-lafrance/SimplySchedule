# Firebase client configuration for the Simply Schedule Expo app.
# Copy this file to .env.local and replace each placeholder locally.
# These values are client configuration, not service-account credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=simply-schedule.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=simply-schedule
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=simply-schedule.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me

# Optional local Auth + Firestore emulator proof. The iOS Simulator can reach
# the host emulators through 127.0.0.1.
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_SEED_EMULATOR=false
