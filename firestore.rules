rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validScheduleColor(value) {
      return value in ['blue', 'teal', 'green', 'yellow', 'peach', 'red', 'mauve'];
    }

    function validTask(data) {
      return data.keys().hasAll([
          'title',
          'notes',
          'status',
          'parentId',
          'dueAt',
          'completedAt',
          'position',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'notes',
          'status',
          'parentId',
          'dueAt',
          'completedAt',
          'position',
          'createdAt',
          'updatedAt',
          'color'
        ])
        && (!data.keys().hasAny(['color']) || validScheduleColor(data.color))
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.notes is string
        && data.notes.size() <= 5000
        && data.status in ['open', 'completed']
        && (data.parentId == null || data.parentId is string)
        && (data.dueAt == null || data.dueAt is timestamp)
        && (data.completedAt == null || data.completedAt is timestamp)
        && data.position is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTermination(data) {
      return data.keys().hasAll(['type', 'until', 'count'])
        && data.keys().hasOnly(['type', 'until', 'count'])
        && data.type in ['never', 'onDate', 'afterOccurrences']
        && (data.until == null || data.until is timestamp)
        && (data.count == null || data.count is int)
        && (
          (data.type == 'never' && data.until == null && data.count == null)
          || (data.type == 'onDate' && data.until is timestamp && data.count == null)
          || (data.type == 'afterOccurrences' && data.until == null && data.count is int && data.count > 0)
        );
    }

    function validDaysOfWeek(data) {
      return data == null
        || (
          data is list
          && data.size() > 0
          && data.size() <= 7
          && (data.size() < 1 || (data[0] is int && data[0] >= 0 && data[0] <= 6))
          && (data.size() < 2 || (data[1] is int && data[1] >= 0 && data[1] <= 6))
          && (data.size() < 3 || (data[2] is int && data[2] >= 0 && data[2] <= 6))
          && (data.size() < 4 || (data[3] is int && data[3] >= 0 && data[3] <= 6))
          && (data.size() < 5 || (data[4] is int && data[4] >= 0 && data[4] <= 6))
          && (data.size() < 6 || (data[5] is int && data[5] >= 0 && data[5] <= 6))
          && (data.size() < 7 || (data[6] is int && data[6] >= 0 && data[6] <= 6))
        );
    }

    function validRecurrenceSelectors(data) {
      return (
          data.frequency in ['hourly', 'daily']
          && data.daysOfWeek == null
          && data.dayOfMonth == null
          && data.weekOfMonth == null
          && data.monthOfYear == null
        )
        || (
          data.frequency == 'weekly'
          && data.daysOfWeek != null
          && data.dayOfMonth == null
          && data.weekOfMonth == null
          && data.monthOfYear == null
        )
        || (
          data.frequency == 'monthly'
          && data.monthOfYear == null
          && (
            (
              data.dayOfMonth != null
              && data.weekOfMonth == null
              && data.daysOfWeek == null
            )
            || (
              data.dayOfMonth == null
              && data.weekOfMonth != null
              && data.daysOfWeek != null
            )
          )
        )
        || (
          data.frequency == 'yearly'
          && data.monthOfYear != null
          && (
            (
              data.dayOfMonth != null
              && data.weekOfMonth == null
              && data.daysOfWeek == null
            )
            || (
              data.dayOfMonth == null
              && data.weekOfMonth != null
              && data.daysOfWeek != null
            )
          )
        );
    }

    function validRecurrence(data) {
      return data.keys().hasAll([
          'version',
          'frequency',
          'interval',
          'daysOfWeek',
          'dayOfMonth',
          'weekOfMonth',
          'monthOfYear',
          'termination'
        ])
        && data.keys().hasOnly([
          'version',
          'frequency',
          'interval',
          'daysOfWeek',
          'dayOfMonth',
          'weekOfMonth',
          'monthOfYear',
          'termination'
        ])
        && data.version == 1
        && data.frequency in ['hourly', 'daily', 'weekly', 'monthly', 'yearly']
        && data.interval is int
        && data.interval > 0
        && data.interval <= 99
        && validDaysOfWeek(data.daysOfWeek)
        && (
          data.dayOfMonth == null
          || (data.dayOfMonth is int && (data.dayOfMonth == -1 || (data.dayOfMonth >= 1 && data.dayOfMonth <= 31)))
        )
        && (
          data.weekOfMonth == null
          || (data.weekOfMonth is int && (data.weekOfMonth == -1 || (data.weekOfMonth >= 1 && data.weekOfMonth <= 5)))
        )
        && (
          data.monthOfYear == null
          || (data.monthOfYear is int && data.monthOfYear >= 1 && data.monthOfYear <= 12)
        )
        && data.termination is map
        && validTermination(data.termination)
        && validRecurrenceSelectors(data);
    }

    function validEvent(data) {
      return data.keys().hasAll([
          'title',
          'notes',
          'kind',
          'startsAt',
          'endsAt',
          'allDay',
          'timeZone',
          'recurrence',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'notes',
          'kind',
          'startsAt',
          'endsAt',
          'allDay',
          'timeZone',
          'recurrence',
          'createdAt',
          'updatedAt',
          'color'
        ])
        && (!data.keys().hasAny(['color']) || validScheduleColor(data.color))
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.notes is string
        && data.notes.size() <= 5000
        && data.kind in ['single', 'repeating']
        && data.startsAt is timestamp
        && data.allDay is bool
        && (
          (data.allDay && data.endsAt is timestamp && data.endsAt > data.startsAt)
          || (!data.allDay && (data.endsAt == null || (data.endsAt is timestamp && data.endsAt > data.startsAt)))
        )
        && data.timeZone is string
        && data.timeZone.size() > 0
        && data.timeZone.size() <= 100
        && (
          (data.kind == 'single' && data.recurrence == null)
          || (data.kind == 'repeating' && data.recurrence is map && validRecurrence(data.recurrence))
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validTask(request.resource.data);
        allow update: if isOwner(userId)
          && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validEvent(request.resource.data);
        allow update: if isOwner(userId)
          && validEvent(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
