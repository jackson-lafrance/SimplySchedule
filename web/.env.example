# Firebase web configuration for the Simply Schedule project.
# Copy this file to .env.local and replace each placeholder locally.
# These values are client configuration, not service-account credentials.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=simply-schedule.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=simply-schedule
VITE_FIREBASE_STORAGE_BUCKET=simply-schedule.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Optional local proof mode. The Auth and Firestore emulators use the ports in
# ../firebase.json. Seeding writes four view-only sample events only when the
# emulator is enabled and the anonymous user's event collection is empty.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_SEED_EMULATOR=false
